# Generated at runtime by scripts/gen-configs.sh — do not edit in container.
# Valid SmartDNS DoT + DoH TLS directive model.

server-name dot.example.com
# -force-aaaa-soa is a bind option. It blocks IPv6 direct-connect bypass.
bind 0.0.0.0:53 -force-aaaa-soa
bind-tcp 0.0.0.0:53 -force-aaaa-soa
# DOT_PORT / DOH_PORT are configurable. Same cert for both.
bind-tls 0.0.0.0:853 -force-aaaa-soa
# DoH endpoint: https://dot.example.com:4430/dns-query
# Port 443 is intentionally NOT used — sniproxy owns streaming SNI unlock.
bind-https 0.0.0.0:4430 -force-aaaa-soa
bind-cert-file /etc/unlock/letsencrypt/certificates/dot.example.com.crt
bind-cert-key-file /etc/unlock/letsencrypt/certificates/dot.example.com.key

cache-size 32768
prefetch-domain yes
dualstack-ip-selection yes
speed-check-mode ping,tcp:80,tcp:443
log-level info
log-console yes
server 1.1.1.1
server 1.0.0.1
# address /netflix.com/<UNLOCK_IP>
