# =============================================================================
# unlock 解锁机（数据面）环境变量示例
# 用法：在 unlock/ 目录 cp .env.example .env 后修改；docker compose up -d
# 与中心 unlock-center 联调时：见 ../unlock-center/README.md §4
# =============================================================================

# 容器时区（域名日更时刻、日志）
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 一、本机身份与访问控制
# -----------------------------------------------------------------------------
# 本机公网 IP。SmartDNS 会把流媒体域名解析成这个地址，客户端再连本机 80/443。
# 必须填对，否则客户端会连错机器。
UNLOCK_IP=203.0.113.10

# 谁可以访问本机 DNS/DoT/DoH 与 sniproxy（80/443）
# 支持多个 CIDR，逗号分隔。配合中心时务必包含：
#   - 你家宽/客户端网段
#   - 中心机公网 IP/32（中心要访问本机 53 做「未命中代查」）
ALLOWED_IPS=198.51.100.10/32
ENABLE_ACL=1
# ENABLE_ACL=0 会关掉防火墙白名单，生产极度不推荐

# -----------------------------------------------------------------------------
# 二、DNS / DoT / DoH（至少开一个；443 永远留给 sniproxy）
# -----------------------------------------------------------------------------
# 三个开关彼此独立。示例：
#   仅明文（无域名无证书）：ENABLE_DNS=1 ENABLE_DOT=0 ENABLE_DOH=0
#   仅 DoT：ENABLE_DNS=0 ENABLE_DOT=1 ENABLE_DOH=0
#   仅 DoH：ENABLE_DNS=0 ENABLE_DOT=0 ENABLE_DOH=1 DOH_PORT=9853
#   明文+DoH：ENABLE_DNS=1 ENABLE_DOT=0 ENABLE_DOH=1
#
# 当本机只当「中心下面的数据面」时，推荐：
#   ENABLE_DNS=1（给中心代查）、ENABLE_DOT=0、ENABLE_DOH=0
#   客户端 DoH 只指中心，不指本机。
ENABLE_DNS=0
DNS_UDP_PORT=53
ENABLE_DOT=1
DOT_PORT=853
ENABLE_DOH=1
# SmartDNS DoH 路径固定 /dns-query；端口不要用 443（sniproxy 占用）
DOH_PORT=4430

# 上游递归（解析非劫持域名、或内部需求）
UPSTREAM_DNS=1.1.1.1,1.0.0.1,8.8.8.8
# yes：对客户端不返回 AAAA，避免 IPv6 绕过 sniproxy
FORCE_AAAA_SOA=yes
# 仅 streamconfig 回退过滤用；一般保持 all
PLATFORMS=all
REGIONS=

# -----------------------------------------------------------------------------
# 三、域名列表自动更新（可配置，不是写死）
# -----------------------------------------------------------------------------
# 镜像内 domains/all.txt 只是启动 seed。
# domain-updater 按 DOMAIN_LIST_URL 拉取远程清单并热重载 SmartDNS/sniproxy。
#
# ENABLE_DOMAIN_AUTO_UPDATE=0 → 不拉远程，只用镜像内/已下载列表
# DOMAIN_LIST_URL → 默认同仓库 raw；可改成你自己的「一行一个域名」文本
# 仓库 Action 约 03:00（上海）重建 all.txt；容器默认 04:00 拉（时刻可改）
ENABLE_DOMAIN_AUTO_UPDATE=1
DOMAIN_LIST_URL=https://raw.githubusercontent.com/Lanlan13-14/Proxym-Easy/main/unlock/domains/all.txt
DOMAIN_UPDATE_HOUR=4
DOMAIN_UPDATE_MINUTE=0
# 远程行数少于此则拒绝更新，保留旧表（防拉到空文件）
MIN_DOMAIN_COUNT=800

# -----------------------------------------------------------------------------
# 四、DoT/DoH 证书（仅 ENABLE_DOT 或 ENABLE_DOH 为 1 时需要）
# -----------------------------------------------------------------------------
# 纯明文 DNS 可整段留空。letsencrypt 仅支持 Cloudflare DNS-01。
DOT_DOMAIN=dot.example.com
DOT_TLS_MODE=letsencrypt
LE_EMAIL=admin@example.com
# Cloudflare Token：Zone:Read + DNS:Edit，建议限制到该域名所在 Zone
CF_DNS_API_TOKEN=CHANGE_TO_CLOUDFLARE_DNS_API_TOKEN
RENEW_CHECK_HOURS=12
RENEW_BEFORE_DAYS=30

# -----------------------------------------------------------------------------
# 五、Cloudflare Zero Trust WARP（强制，出口必须是本机目标区）
# -----------------------------------------------------------------------------
# 日机用日本策略、美机用美国策略；WARP 失败则 fail-closed，不启动/退出 sniproxy。
# 不要填完整 xxx.cloudflareaccess.com，只填 team 名；用 Service Token 注册。
WARP_ORGANIZATION=your-team-name
WARP_CLIENT_ID=CHANGE_TO_SERVICE_TOKEN_CLIENT_ID
WARP_CLIENT_SECRET=CHANGE_TO_SERVICE_TOKEN_CLIENT_SECRET
WARP_REGISTER_TIMEOUT=240
WARP_CONNECT_TIMEOUT=120
# 定期整容器干净重启周期（小时），降低长连接异常
ZT_RESTART_HOURS=12

# -----------------------------------------------------------------------------
# 六、可选 SOCKS5（与 DNS 解锁独立；默认关）
# -----------------------------------------------------------------------------
ENABLE_SOCKS5=0
SOCKS5_PORT=1080
# RFC1929：用户名密码任意 1–255 字节（可中文、符号），不是 Linux 账户
SOCKS5_USERNAME=用户@Foo:Bar 1!
SOCKS5_PASSWORD=ChangeThis_ToAUniqueStrongPassword:也行
# SOCKS 源 IP 白名单，与上面 ALLOWED_IPS 完全独立；可 0.0.0.0/0（仍要密码）
SOCKS5_ALLOWED_IPS=0.0.0.0/0
# 仅可靠 TCP CONNECT；不宣称 UDP ASSOCIATE（Docker bridge 下中继地址对公网不可用）
