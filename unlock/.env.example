# ===== Proxym-Easy DNS Unlock =====
TZ=Asia/Shanghai

# Public IP of THIS unlock host. Streaming domains resolve to this IP.
# Do NOT leave it to auto-detection on a NAT/proxy host; set it explicitly.
UNLOCK_IP=203.0.113.10

# Source IP/CIDR allowed to access DNS / DoT / 80 / 443.
# Comma-separated. Example: 198.51.100.8/32,198.51.100.0/24
# Empty disables the in-container ACL — unsafe for a public VPS.
ALLOWED_IPS=198.51.100.8/32
ENABLE_ACL=1

# ===== Listening ports =====
# All port mappings are dynamic: host port == container port.
DNS_UDP_PORT=53
# Custom DoT port is supported. Standard DoT uses 853.
DOT_PORT=853
# HTTP/80 and HTTPS/443 are intentionally fixed: transparent DNS unlock
# clients always use those destination ports after resolving a streaming name.

# Recursive upstreams used for non-unlock domains
UPSTREAM_DNS=1.1.1.1,1.0.0.1,8.8.8.8
# Default yes avoids IPv6 direct-connect bypass on IPv4-only unlock hosts.
# Change to no only when UNLOCK_IP / sniproxy are deliberately reachable over IPv6.
FORCE_AAAA_SOA=yes

# ===== Real DoT TLS: Let's Encrypt DNS-01 using Cloudflare =====
# DOT_DOMAIN MUST be a public FQDN under a DNS zone in your Cloudflare account.
# Add an A/AAAA record for this name to UNLOCK_IP and set it to DNS-only (grey cloud).
DOT_DOMAIN=dot.example.com
DOT_TLS_MODE=letsencrypt
LE_EMAIL=admin@example.com
# Restricted Cloudflare API Token: Zone:Read + DNS:Edit, limited to DOT_DOMAIN's zone.
# Never commit this value.
CF_DNS_API_TOKEN=
# Renewal check period / renew threshold. DNS-01 needs no inbound HTTP-01 port.
RENEW_CHECK_HOURS=12
RENEW_BEFORE_DAYS=30

# Test-only escape hatch. Never use it for public clients:
# DOT_TLS_MODE=selfsigned
# Production custom cert/key mode, mounted separately:
# DOT_TLS_MODE=custom
# TLS_CERT=/etc/unlock/tls/fullchain.pem
# TLS_KEY=/etc/unlock/tls/privkey.pem

# Domain selection from StreamConfig.yaml
# PLATFORMS=all  or  Netflix,DisneyPlus,YouTube
# REGIONS=  or  Taiwan_Media,HongKong_Media,Japan_Media
PLATFORMS=all
REGIONS=

# ===== Cloudflare Zero Trust tunnel (optional) =====
# This is a cloudflared Tunnel token, not a WARP/Connector token.
CF_TUNNEL_TOKEN=
ENABLE_ZT=auto
# Scheduled cloudflared restart period, in hours.
ZT_RESTART_HOURS=12
