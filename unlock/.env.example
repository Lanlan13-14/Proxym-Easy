TZ=Asia/Shanghai

# ===== Unlock service source ACL =====
UNLOCK_IP=203.0.113.10
# DNS/DoT + transparent sniproxy source whitelist. Separate from SOCKS5.
ALLOWED_IPS=198.51.100.10/32
ENABLE_ACL=1

# ===== DNS / DoT =====
# Internal plaintext SmartDNS port. It is never published by Compose.
DNS_UDP_PORT=53
DOT_PORT=853
UPSTREAM_DNS=1.1.1.1,1.0.0.1,8.8.8.8
FORCE_AAAA_SOA=yes
PLATFORMS=all
REGIONS=

# ===== DoT TLS: Let's Encrypt DNS-01 via Cloudflare =====
DOT_DOMAIN=dot.example.com
DOT_TLS_MODE=letsencrypt
LE_EMAIL=admin@example.com
# Zone:Read + DNS:Edit, restricted to the DNS zone holding DOT_DOMAIN.
CF_DNS_API_TOKEN=CHANGE_TO_CLOUDFLARE_DNS_API_TOKEN
RENEW_CHECK_HOURS=12
RENEW_BEFORE_DAYS=30

# ===== Mandatory Cloudflare Zero Trust WARP =====
WARP_ORGANIZATION=your-team-name
WARP_CLIENT_ID=CHANGE_TO_SERVICE_TOKEN_CLIENT_ID
WARP_CLIENT_SECRET=CHANGE_TO_SERVICE_TOKEN_CLIENT_SECRET
WARP_REGISTER_TIMEOUT=240
WARP_CONNECT_TIMEOUT=120
ZT_RESTART_HOURS=12

# ===== Optional SOCKS5 through Zero Trust WARP =====
# Disabled by default. Set to 1 only after filling every SOCKS5_* field.
ENABLE_SOCKS5=0
# Public SOCKS5 TCP listener. Username/password authentication is mandatory.
SOCKS5_PORT=1080
# RFC1929 free-charset credentials: any 1-255 byte string (UTF-8 / symbols /
# spaces / ':' / email-like). Not a Linux account. No embedded newline/NUL.
SOCKS5_USERNAME=用户@Foo:Bar 1!
SOCKS5_PASSWORD=ChangeThis_ToAUniqueStrongPassword:也行
# SOCKS source ACL. It is independent from ALLOWED_IPS above and supports any
# CIDR including 0.0.0.0/0 (still protected by username/password auth).
SOCKS5_ALLOWED_IPS=0.0.0.0/0
# This deployment intentionally supports reliable SOCKS5 TCP CONNECT only.
# UDP ASSOCIATE is not advertised through Docker bridge NAT.
