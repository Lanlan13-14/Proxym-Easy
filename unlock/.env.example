TZ=Asia/Shanghai

# Unlock host and client whitelist
UNLOCK_IP=203.0.113.10
ALLOWED_IPS=198.51.100.8/32
ENABLE_ACL=1
# Container-internal plaintext DNS for SmartDNS health/local use; not published.
DNS_UDP_PORT=53
# Public encrypted DNS-over-TLS port.
DOT_PORT=853
UPSTREAM_DNS=1.1.1.1,1.0.0.1,8.8.8.8
FORCE_AAAA_SOA=yes
PLATFORMS=all
REGIONS=

# Real DoT TLS: Let's Encrypt DNS-01 with a restricted Cloudflare API Token
DOT_DOMAIN=dot.example.com
DOT_TLS_MODE=letsencrypt
LE_EMAIL=admin@example.com
CF_DNS_API_TOKEN=
RENEW_CHECK_HOURS=12
RENEW_BEFORE_DAYS=30

# Mandatory Cloudflare Zero Trust WARP egress
# Team name only, without .cloudflareaccess.com
WARP_ORGANIZATION=brightandy
# Service Token Client ID / Secret. The token must be selected in a Device
# Enrollment policy whose action is Service Auth (Allow does not work).
WARP_CLIENT_ID=
WARP_CLIENT_SECRET=
WARP_REGISTER_TIMEOUT=240
WARP_CONNECT_TIMEOUT=120
# Cleanly restart the whole container/WARP session on this interval.
ZT_RESTART_HOURS=12
