# =============================================================================
# unlock-center 环境变量示例（Docker Compose 用）
# 用法：cp .env.example .env 后按注释修改；配合 nodes.toml 使用。
# 详细逻辑见 README.md §2.1（DNS 查询）与 §4（端到端部署）。
# =============================================================================

# 容器时区：影响 GeoIP 日更时刻、证书续期日志时间显示
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 一、客户端入口：明文 DNS / DoT / DoH（至少开一个）
# -----------------------------------------------------------------------------
# 中心只做 DNS 调度，不做 sniproxy。客户端应把 DoH/DoT 指到本机域名。
#
# CENTER_ENABLE_DNS=1 时对外提供明文 53；生产更推荐只开 DoT/DoH。
CENTER_ENABLE_DNS=0
DNS_UDP_PORT=53

# DNS-over-TLS（需证书，见第三节）
CENTER_ENABLE_DOT=1
DOT_PORT=853

# DNS-over-HTTPS（需证书；路径可伪装，见 DOH_BASE_PATH）
CENTER_ENABLE_DOH=1
DOH_PORT=443

# DoH URL 路径前缀（可任意改，不要泄露成显眼的 /dns-query 也可）
# 合法示例（base=/api/v2/weather）：
#   https://域名/api/v2/weather              → 默认全局区
#   https://域名/api/v2/weather/us           → Netflix 等 global 走 us
#   https://域名/api/v2/weather/sg           → global 走新加坡
#   https://域名/api/v2/weather/us/ai/jp     → global=us，AI=jp
#   https://域名/api/v2/weather/ai/jp        → global=默认，AI=jp
# 路径只影响 global/AI；日区/港区等 regional 仍按域名表，多区可同时解锁。
DOH_BASE_PATH=/api/v2/weather

# -----------------------------------------------------------------------------
# 二、解锁策略
# -----------------------------------------------------------------------------
# UNLOCK_SCOPE：哪些域名类别会被「劫持」成解锁机 IP
#   all       = global + regional + ai（默认，推荐）
#   global    = 只劫持全球向流媒体/AI；区锁域名当普通站代查
#   regional  = 只劫持区锁；Netflix 等不解锁
UNLOCK_SCOPE=all

# 默认「全局区」：DoH 未带 /us|/jp|… 时，Netflix 等 global 域名去哪台解锁机
# 必须与 nodes.toml 里某节点的 region 一致，且在 allow_regions 内
DEFAULT_GLOBAL_REGION=us

# 默认 AI 区：空 = 跟随上面的全局区；也可写成 jp/us 等钉死
DEFAULT_AI_REGION=

# 非解锁域名（表外）代查时，GeoIP 失败则用哪个区的解锁机当 DNS 上游
DEFAULT_PASSTHROUGH_REGION=us

# 分类域名表 URL（中心定时拉取）。默认仓库 raw，可改自建。
# 格式见 domains/domain-region.map：域名<TAB>global|regional|ai<TAB>区或-
DOMAIN_MAP_URL=https://raw.githubusercontent.com/Lanlan13-14/Proxym-Easy/main/unlock-center/domains/domain-region.map

# -----------------------------------------------------------------------------
# 三、TLS 证书（仅 DoT 或 DoH 开启时需要）
# -----------------------------------------------------------------------------
# CENTER_ENABLE_DOT=0 且 CENTER_ENABLE_DOH=0 时：证书整段可空，cert-manager 跳过。
#
# CENTER_TLS_MODE（也可用 DOT_TLS_MODE 别名，entrypoint/cert-manager 会读）：
#   letsencrypt — Let’s Encrypt + 仅 Cloudflare DNS-01（推荐生产）
#   selfsigned  — openssl 自签，仅测试
#   files       — 自备文件，放到 DATA_DIR/tls/cert.pem 与 key.pem
#
# letsencrypt 完整必填：
#   CENTER_DOT_DOMAIN   证书 CN/SAN、DoT SNI、DoH 访问主机名（公网 FQDN）
#   LE_EMAIL            Let’s Encrypt 注册邮箱
#   CF_DNS_API_TOKEN    Cloudflare API Token（权限见下）
# 可选：
#   DOT_EXTRA_DOMAINS   额外 SAN，逗号分隔
#   LEGO_CA_SERVER      默认正式 CA；测试：
#                       https://acme-staging-v02.api.letsencrypt.org/directory
#   RENEW_CHECK_HOURS   续期检查周期（小时），默认 12
#   RENEW_BEFORE_DAYS   剩余天数 ≤ 此值则续期，默认 30
#
# Cloudflare 准备步骤（DNS-01，无需 80 端口 HTTP-01）：
#   1. 域名已接入 Cloudflare（NS 已生效）
#   2. 为 CENTER_DOT_DOMAIN 建 A/AAAA → 中心公网 IP
#      证书申请阶段建议「仅 DNS / 灰云」；DNS-01 不依赖橙云代理
#   3. 创建 API Token：
#      Cloudflare 仪表盘 → 我的个人资料 → API 令牌 → 创建令牌
#      权限：
#        - Zone / Zone / Read
#        - Zone / DNS / Edit
#      区域资源：包括 - 特定区域 - 选中 CENTER_DOT_DOMAIN 所在 zone
#   4. 将令牌填入 CF_DNS_API_TOKEN（不要提交到 git）
#
# 容器内流程（scripts/cert-manager.sh）：
#   entrypoint → ensure（没有证就 lego run --dns cloudflare）
#   后台 renew-loop 按 RENEW_CHECK_HOURS 调用 lego renew
#   证书路径：/data/letsencrypt/certificates/<域名>.crt|.key
#   并软链到 /data/tls/cert.pem 与 key.pem 供进程读取
#   续期成功后 SIGHUP 通知 unlock-center（pid 文件 CENTER_PID_FILE）
#
# 注意：DoT/DoH 共用这一张证；与解锁机 unlock 的 DOT_DOMAIN 可以不同域名。
#
CENTER_TLS_MODE=letsencrypt
CENTER_DOT_DOMAIN=dns.example.com
LE_EMAIL=admin@example.com
CF_DNS_API_TOKEN=CHANGE_ME
# DOT_EXTRA_DOMAINS=
# LEGO_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
RENEW_CHECK_HOURS=12
RENEW_BEFORE_DAYS=30

# -----------------------------------------------------------------------------
# 四、GeoIP（非解锁「就近代查」用；不决定 Netflix 区）
# -----------------------------------------------------------------------------
# 客户端 IP → 经纬度 → 选 lat/lon 最近的解锁机，向其 :53 问真实 DNS。
GEOIP_ENABLE=1
GEOIP_ENABLE_AUTO_UPDATE=1
# 每天何时更新 MMDB（按上面 TZ）
GEOIP_UPDATE_HOUR=4
GEOIP_UPDATE_MINUTE=0
GEOIP_DB_PATH=/data/geoip/GeoLite2-City.mmdb

# 内置默认下载地址（无需 MaxMind 账号）。可改镜像站；不填脚本也会用同一默认。
GEOIP_DB_URL=https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-City.mmdb

# 可选：填了则优先走 MaxMind 官方 GeoLite2（覆盖 GEOIP_DB_URL）
# MAXMIND_LICENSE_KEY=
# MAXMIND_EDITION_ID=GeoLite2-City

# -----------------------------------------------------------------------------
# 五、节点表与其它
# -----------------------------------------------------------------------------
# Compose 已把 ./nodes.toml 挂到容器内；一般不用改下一行
# NODES_FILE=/etc/unlock-center/nodes.toml

# 日志级别：info / debug / warn
CENTER_LOG_LEVEL=info
