TZ=Asia/Shanghai

# ===== DNS listeners =====
CENTER_ENABLE_DNS=0
DNS_UDP_PORT=53
CENTER_ENABLE_DOT=1
DOT_PORT=853
CENTER_ENABLE_DOH=1
DOH_PORT=443
# Camouflage DoH path (not limited to /dns-query)
DOH_BASE_PATH=/api/v2/weather

# ===== Policy =====
UNLOCK_SCOPE=all
DEFAULT_GLOBAL_REGION=us
DEFAULT_AI_REGION=
DEFAULT_PASSTHROUGH_REGION=us
DOMAIN_MAP_URL=https://raw.githubusercontent.com/Lanlan13-14/Proxym-Easy/main/unlock-center/domains/domain-region.map

# ===== TLS (DoT/DoH) — same model as unlock =====
# letsencrypt | selfsigned | files
CENTER_TLS_MODE=letsencrypt
CENTER_DOT_DOMAIN=dns.example.com
LE_EMAIL=admin@example.com
# Cloudflare API token: Zone:Read + DNS:Edit on DOT_DOMAIN zone only
CF_DNS_API_TOKEN=CHANGE_ME
RENEW_CHECK_HOURS=12
RENEW_BEFORE_DAYS=30

# ===== GeoIP nearest (custom update time) =====
GEOIP_ENABLE=1
GEOIP_ENABLE_AUTO_UPDATE=1
GEOIP_UPDATE_HOUR=4
GEOIP_UPDATE_MINUTE=0
GEOIP_DB_PATH=/data/geoip/GeoLite2-City.mmdb
# Built-in default City MMDB (no license key). Change only if you need a private mirror.
GEOIP_DB_URL=https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-City.mmdb
# Optional: official MaxMind instead of GEOIP_DB_URL
# MAXMIND_LICENSE_KEY=your_key
# MAXMIND_EDITION_ID=GeoLite2-City

# ===== Nodes =====
# Mount real file at /etc/unlock-center/nodes.toml
# NODES_FILE=/etc/unlock-center/nodes.toml

CENTER_LOG_LEVEL=info
